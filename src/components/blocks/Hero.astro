---
const { value } = Astro.props;
---
<section class="band intro hero-band">
	<div class="frame">
		<h1 class="intro__title">{value.heading}</h1>
		{value.body && <p class="intro__lead">{value.body}</p>}
		{value.cta_label && value.cta_url && (
			<div class="hero__ctas">
				<a href={value.cta_url} class="btn">{value.cta_label}</a>
			</div>
		)}
	</div>
</section>
<style>
	.hero-band .hero__ctas { display: flex; flex-wrap: wrap; gap: var(--spacing-3); margin-top: var(--spacing-8); }
</style>