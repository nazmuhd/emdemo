---
import { getEmDashCollection, getTermsForEntries } from "emdash";
import Base from "../../layouts/Base.astro";
import PostCard from "../../components/PostCard.astro";
import Pagination from "../../components/Pagination.astro";

const cursor = Astro.url.searchParams.get("cursor") || undefined;
const {
	entries: cases,
	cacheHint,
	nextCursor,
} = await getEmDashCollection("case_studies", {
	orderBy: { published_at: "desc" },
	limit: 20,
	cursor,
});

if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

const tagsByEntry = await getTermsForEntries(
	"case_studies",
	cases.map((c) => c.data.id),
	"tag",
);

const casesWithTags = cases.map((c) => ({
	entry: c,
	tags: tagsByEntry.get(c.data.id) ?? [],
}));
---

<Base title="Case Studies" description="Browse all case studies">
	<header class="band intro">
		<div class="frame">
			<p class="eyebrow">Work</p>
			<h1 class="intro__title">Case Studies</h1>
			<p class="intro__lead">Selected projects and outcomes.</p>
		</div>
	</header>

	<section class="band section archive-band">
		<div class="frame">
			{
				cases.length === 0 ? (
					<div class="empty-state">
						<h2 class="empty-state__title">
							{cursor ? "No more case studies" : "No case studies yet"}
						</h2>
						<p class="empty-state__text">
							{cursor
								? "You have reached the end of the archive."
								: "Published case studies will show up here."}
						</p>
						{cursor && (
							<div class="empty-state__actions">
								<a href="/case-studies" class="btn btn--ghost">
									First page
								</a>
							</div>
						)}
					</div>
				) : (
					<>
						<div class="post-grid cases-grid">
							{casesWithTags.map(({ entry, tags }) => (
								<PostCard post={entry} tags={tags} variant="card" basePath="/case-studies" />
							))}
						</div>
						<Pagination
							basePath="/case-studies"
							cursor={cursor}
							nextCursor={nextCursor}
						/>
					</>
				)
			}
		</div>
	</section>
</Base>

<style>
	.cases-grid {
		grid-template-columns: repeat(3, minmax(0, 1fr));
	}
	@media (max-width: 900px) {
		.cases-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
	}
	@media (max-width: 600px) {
		.cases-grid { grid-template-columns: minmax(0, 1fr); }
	}
</style>