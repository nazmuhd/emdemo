---
import {
	getEmDashEntry,
	getEmDashCollection,
	getSeoMeta,
	decodeSlug,
	getSiteSettings,
} from "emdash";
import { Image, PortableText, WidgetArea } from "emdash/ui";
import Base from "../../layouts/Base.astro";
import Byline from "../../components/Byline.astro";
import PostCard from "../../components/PostCard.astro";
import { formatDate } from "../../utils/locale";
import { getReadingTime } from "../../utils/reading-time";
import { resolveBlogSiteIdentity } from "../../utils/site-identity";
import "../../styles/prose.css";

const slug = decodeSlug(Astro.params.slug);
if (!slug) return Astro.rewrite("/404");

const { entry: study, cacheHint } = await getEmDashEntry("case_studies", slug);
if (!study) return Astro.rewrite("/404");
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

function getImageUrl(img: unknown): string | undefined {
	if (!img || typeof img !== "object") return undefined;
	const image = img as Record<string, unknown>;
	if (typeof image.src === "string" && image.src) {
		return image.src.startsWith("http") ? image.src : `${Astro.url.origin}${image.src}`;
	}
	const meta = image.meta as Record<string, unknown> | undefined;
	const storageKey =
		(typeof meta?.storageKey === "string" ? meta.storageKey : undefined) ||
		(typeof image.id === "string" ? image.id : undefined);
	if (storageKey) return `${Astro.url.origin}/_emdash/api/media/file/${storageKey}`;
	return undefined;
}
const featuredImageUrl = getImageUrl(study.data.featured_image);
const { siteTitle } = resolveBlogSiteIdentity(await getSiteSettings());

const seo = getSeoMeta(study, {
	siteTitle,
	siteUrl: Astro.url.origin,
	path: Astro.url.pathname.replace(/\/$/, ""),
	defaultOgImage: featuredImageUrl,
});

const bylines = study.data.bylines ?? [];
const readingTime = getReadingTime(study.data.content);
const tags = study.data.terms?.tag ?? [];

const { entries: recentStudies } = await getEmDashCollection("case_studies", {
	orderBy: { published_at: "desc" },
	limit: 4,
});
const otherStudies = recentStudies.filter((s) => s.id !== study.id).slice(0, 3);

const publishedAt = study.data.publishedAt ?? null;
const publishDate = publishedAt ? formatDate(publishedAt, "long") : null;

const hasHeadings = (study.data.content ?? []).some(
	(block) => block._type === "block" && "style" in block && (block.style === "h2" || block.style === "h3"),
);
---

<Base
	title={seo.title}
	pageTitle={seo.ogTitle}
	description={seo.description}
	image={seo.ogImage}
	canonical={seo.canonical}
	robots={seo.robots}
	type="article"
	publishedTime={study.data.publishedAt?.toISOString() ?? null}
	modifiedTime={study.data.updatedAt.toISOString()}
	content={{ collection: "case_studies", id: study.data.id, slug }}
>
	<article class="post">
		<header class="intro post-header">
			<div class="frame">
				<div class="post-header__inner">
					<a href="/case-studies" class="arrow-link back-link">
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5"></path><path d="m12 19-7-7 7-7"></path></svg>
						All case studies
					</a>
					{tags.length > 0 && (
						<ul class="chips post-header__tags" aria-label="Tags">
							{tags.map((t) => (
								<li><a href={`/tag/${t.slug}`} class="chip">{t.label}</a></li>
							))}
						</ul>
					)}
					<h1 class="intro__title post-header__title" {...study.edit.title}>{study.data.title}</h1>
					{study.data.excerpt && <p class="intro__lead post-header__lead" {...study.edit.excerpt}>{study.data.excerpt}</p>}
					<div class="post-header__meta">
						<Byline bylines={bylines} layout="inline" max={2} size="md" />
						<p class="post-header__dateline">
							{publishedAt && <time datetime={publishedAt.toISOString()}>{publishDate}</time>}
							<span>{readingTime} min read</span>
						</p>
					</div>
				</div>
			</div>
		</header>

		{study.data.featured_image && (
			<div class="band post-hero">
				<div class="frame">
					<div class="post-hero__media" {...study.edit.featured_image}>
						<Image image={study.data.featured_image} sizes="(min-width: 1264px) 1136px, 92vw" priority />
					</div>
				</div>
			</div>
		)}

		<div class="band section">
			<div class="frame post-layout">
				<div class="post-meta">
					<dl class="post-facts">
						{study.data.client && (
							<div class="post-fact">
								<dt class="eyebrow">Client</dt>
								<dd>{study.data.client}</dd>
							</div>
						)}
						{study.data.industry && (
							<div class="post-fact">
								<dt class="eyebrow">Industry</dt>
								<dd>{study.data.industry}</dd>
							</div>
						)}
						{study.data.services && (
							<div class="post-fact">
								<dt class="eyebrow">Services</dt>
								<dd>{study.data.services}</dd>
							</div>
						)}
						{study.data.timeline && (
							<div class="post-fact">
								<dt class="eyebrow">Timeline</dt>
								<dd>{study.data.timeline}</dd>
							</div>
						)}
						{bylines.length > 0 && (
							<div class="post-fact">
								<dt class="eyebrow">{bylines.length === 1 ? "Author" : "Authors"}</dt>
								<dd><Byline bylines={bylines} layout="list" /></dd>
							</div>
						)}
						{publishedAt && (
							<div class="post-fact">
								<dt class="eyebrow">Published</dt>
								<dd><time datetime={publishedAt.toISOString()}>{publishDate}</time></dd>
							</div>
						)}
						<div class="post-fact">
							<dt class="eyebrow">Reading time</dt>
							<dd>{readingTime} min</dd>
						</div>
					</dl>
				</div>

				<div class="post-main">
					<div class="prose" data-post-content>
						<PortableText value={study.data.content} />
					</div>
				</div>

				<div class="post-rail">
					{study.data.results && (
						<div class="case-results">
							<h2 class="eyebrow">Key results</h2>
							<ul class="case-results__list">
								{study.data.results.split("\\n").map((r) => (
									<li>{r}</li>
								))}
							</ul>
						</div>
					)}
					<nav class="toc" aria-labelledby="toc-title" hidden={!hasHeadings} data-toc>
						<h2 id="toc-title" class="eyebrow">On this page</h2>
						<ol class="toc__list" data-toc-list></ol>
					</nav>
				</div>
			</div>
		</div>
	</article>

	{otherStudies.length > 0 && (
		<section class="band section" aria-labelledby="continue-reading">
			<div class="frame related">
				<div class="section-head">
					<h2 id="continue-reading" class="section-head__title">Continue reading</h2>
					<a href="/case-studies" class="arrow-link">All case studies
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14" /><path d="m12 5 7 7-7 7" /></svg>
					</a>
				</div>
				<div class="post-grid">
					{otherStudies.map((s) => (
						<PostCard post={s} variant="card" headingLevel={3} basePath="/case-studies" />
					))}
				</div>
			</div>
		</section>
	)}

	<script>
		function buildToc() {
			const content = document.querySelector("[data-post-content]");
			const toc = document.querySelector<HTMLElement>("[data-toc]");
			const list = document.querySelector("[data-toc-list]");
			if (!content || !toc || !list) return;
			const headings = [...content.querySelectorAll<HTMLHeadingElement>("h2, h3")];
			toc.hidden = headings.length === 0;
			if (headings.length === 0) return;
			const links = new Map<Element, HTMLAnchorElement>();
			headings.forEach((heading, index) => {
				if (!heading.id) heading.id = `heading-${index}`;
				const item = document.createElement("li");
				item.className = heading.tagName === "H3" ? "toc__item toc__item--nested" : "toc__item";
				const link = document.createElement("a");
				link.href = `#${heading.id}`;
				link.className = "toc__link";
				link.textContent = heading.textContent;
				item.appendChild(link);
				list.appendChild(item);
				links.set(heading, link);
			});
			const setCurrent = (link: HTMLAnchorElement) => {
				for (const other of links.values()) other.removeAttribute("aria-current");
				link.setAttribute("aria-current", "true");
			};
			const first = links.values().next().value;
			if (first) setCurrent(first);
			const observer = new IntersectionObserver((entries) => {
				for (const entry of entries) {
					const link = links.get(entry.target);
					if (link && entry.isIntersecting) setCurrent(link);
				}
			}, { rootMargin: "-80px 0px -80% 0px" });
			headings.forEach((heading) => observer.observe(heading));
		}
		buildToc();
	</script>
</Base>

<style>
	.post-header { padding-block: clamp(2rem, 1.25rem + 3vw, 4rem) clamp(2.5rem, 1.75rem + 2.5vw, 3.5rem); }
	.post-header__inner { max-width: var(--content-width); margin-inline: auto; }
	.back-link { margin-block-end: clamp(2rem, 1.5rem + 2vw, 3rem); }
	.back-link:hover svg { translate: -2px 0; }
	.post-header__tags { margin-block-end: var(--spacing-5); }
	.post-header__lead { font-size: var(--font-size-xl); line-height: var(--leading-normal); }
	.post-header__meta { --avatar-ring: var(--color-bg); display: flex; flex-wrap: wrap; align-items: center; gap: var(--spacing-3) var(--spacing-5); margin-block-start: var(--spacing-8); }
	.post-header__meta :global(.byline__names) { overflow: visible; white-space: normal; }
	.post-header__dateline { display: flex; flex-wrap: wrap; column-gap: var(--spacing-2); font-size: var(--font-size-sm); color: var(--color-muted); font-variant-numeric: tabular-nums; }
	.post-header__dateline > * + *::before { content: "·"; content: "·" / ""; margin-inline-end: var(--spacing-2); }
	.post-hero { padding-block: clamp(1rem, 0.5rem + 2vw, 2rem); }
	.post-hero__media { position: relative; overflow: hidden; aspect-ratio: 2 / 1; border-radius: var(--radius-xl); background: var(--color-fill); }
	.post-hero__media::after { content: ""; position: absolute; inset: 0; border-radius: inherit; outline: 1px solid var(--color-media-outline); outline-offset: -1px; pointer-events: none; }
	.post-hero__media :global(img) { width: 100%; max-width: none; height: 100%; object-fit: cover; }
	.post-layout { display: grid; grid-template-columns: minmax(0, 1fr); row-gap: var(--spacing-16); }
	.post-meta, .toc { display: none; }
	.post-main, .post-rail { width: 100%; max-width: var(--content-width); margin-inline: auto; }
	.post-rail { overflow-wrap: anywhere; }
	.post-facts { display: grid; gap: var(--spacing-4); }
	.post-fact dt { margin-block-end: var(--spacing-1); }
	.post-fact dd { font-size: var(--font-size-sm); color: var(--color-text); font-variant-numeric: tabular-nums; }
	.toc h2 { margin-block-end: var(--spacing-4); }
	.toc__list { list-style: none; border-inline-start: 1px solid var(--color-border); }
	.toc :global(.toc__link) { display: block; margin-inline-start: -1px; padding-block: 5px; padding-inline: var(--spacing-3) 0; border-inline-start: 2px solid transparent; color: var(--color-muted); font-size: var(--font-size-sm); line-height: var(--leading-snug); text-decoration: none; transition: color var(--transition-fast), border-color var(--transition-fast); }
	.toc :global(.toc__item--nested .toc__link) { padding-inline-start: var(--spacing-6); }
	.toc :global(.toc__link:hover) { color: var(--color-text); }
	.toc :global(.toc__link[aria-current="true"]) { border-inline-start-color: var(--color-text); color: var(--color-text); }
	@media (min-width: 1100px) {
		.post-header__inner { max-width: none; }
		.post-header__meta { display: none; }
		.post-layout { grid-template-columns: minmax(9rem, var(--meta-col-width)) minmax(36rem, var(--content-width)) minmax(10rem, var(--gutter-width)); align-items: start; justify-content: space-between; gap: var(--spacing-10) clamp(1.5rem, 1rem + 1.5vw, 2.25rem); }
		.post-meta, .post-rail { position: sticky; top: calc(var(--nav-height) + var(--spacing-8)); }
		.post-meta { display: block; }
		.post-main { max-width: none; }
		.post-rail { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--spacing-10); max-width: none; max-height: calc(100vh - var(--nav-height) - var(--spacing-16)); max-height: calc(100dvh - var(--nav-height) - var(--spacing-16)); margin: calc(-1 * var(--spacing-1)); padding: var(--spacing-1); overflow-y: auto; scrollbar-width: thin; }
		.toc { display: block; }
		.toc[hidden] { display: none; }
	}
	.related { container-type: inline-size; }
	.related .post-grid { grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr)); }

	/* Case study rail extras */
	.case-details, .case-results { display: grid; gap: var(--spacing-3); }
	.case-details h2, .case-results h2 { margin-block-end: var(--spacing-3); }
	.case-details__list { display: grid; gap: var(--spacing-3); }
	.case-details__list > div { display: grid; gap: 2px; }
	.case-details__list dt { font-size: var(--font-size-xs); color: var(--color-muted); }
	.case-details__list dd { font-size: var(--font-size-sm); color: var(--color-text); }
	.case-results__list { list-style: none; display: grid; gap: var(--spacing-2); }
	.case-results__list li {
		font-family: var(--font-mono);
		font-size: var(--font-size-sm);
		font-weight: 500;
		color: var(--color-text);
		padding: var(--spacing-2) var(--spacing-3);
		border-radius: var(--radius);
		background: var(--color-surface);
		box-shadow: inset 0 0 0 1px var(--color-border);
	}
</style>